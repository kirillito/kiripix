# Golden images are binary: keep them in git LFS.
tests/golden/**/*.png filter=lfs diff=lfs merge=lfs -text

# Text stays LF everywhere, so hashes and golden palettes match across machines.
*.py text eol=lf
*.toml text eol=lf
*.gpl text eol=lf
*.md text eol=lf
*.yml text eol=lf
uv.lock text eol=lf

# Character test fixtures (built by tests/fixtures/make_character_fixtures.py) are binary: keep them in git LFS.
tests/fixtures/**/*.glb filter=lfs diff=lfs merge=lfs -text
tests/fixtures/**/*.fbx filter=lfs diff=lfs merge=lfs -text
tests/golden/expected/**/*.tscn text eol=lf
tests/golden/expected/**/*.tres text eol=lf

# Audio (recordings, sound fixtures, the M6 trial recordings) is binary: keep it in git LFS (ADR 0016).
*.wav filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
